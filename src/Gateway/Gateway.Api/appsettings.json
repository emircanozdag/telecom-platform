{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "subscribers": {
        "ClusterId": "subscriber",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/subscribers/{**rest}" }
      },
      "plans": {
        "ClusterId": "subscriber",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/plans" }
      },
      "billing": {
        "ClusterId": "billing",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/billing/{**rest}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/notifications/{**rest}" }
      }
    },
    "Clusters": {
      "subscriber": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "billing": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } }
    }
  }
}
